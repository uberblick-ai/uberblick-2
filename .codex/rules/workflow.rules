# Read and write only the PR coordination records Uberblick reviewers own.
prefix_rule(
    pattern = ["gh", "pr", "comment"],
    decision = "allow",
    justification = "Reviewers must write their durable claim and verdict on the assigned PR.",
    match = [
        "gh pr comment 514 --body Done",
        "gh pr comment https://github.com/uberblick-ai/uberblick-2/pull/514 --body-file verdict.md",
    ],
    not_match = ["gh issue comment 514 --body Done"],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "diff"]],
    decision = "allow",
    justification = "PR inspection is read-only review input.",
    match = [
        "gh pr view 514 --comments",
        "gh pr diff 514",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "view"],
    decision = "allow",
    justification = "Issue inspection is read-only review input.",
    match = ["gh issue view 495 --comments"],
)

# These are the repository's documented, non-destructive validation tasks.
prefix_rule(
    pattern = ["mise", "run", ["lint", "typecheck", "test", "e2e", "review"]],
    decision = "allow",
    justification = "Reviewers may run the documented exact-head validation tasks without a human babysitting the pane.",
    match = [
        "mise run lint",
        "mise run typecheck",
        "mise run test",
        "mise run e2e",
        "mise run review c7f63f3136a0a8c56cf69a4787f1eaf4a66440f2",
    ],
    not_match = [
        "mise run dev",
        "mise trust /tmp/review/mise.toml",
    ],
)

# The implementer's own durable records and branch work (codex-first lane, 2026-09-01).
prefix_rule(
    pattern = ["gh", "issue", ["comment", "edit"]],
    decision = "allow",
    justification = "An implementer writes its claim, admission, renewal and return on the issue it holds.",
    match = [
        "gh issue comment 495 --body-file claim.md",
        "gh issue edit 495 --add-label in-progress",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "ready"]],
    decision = "allow",
    justification = "An implementer opens its draft PR, updates its body and marks it ready.",
    match = [
        "gh pr create --draft --title t --body-file body.md",
        "gh pr ready 514",
    ],
)

prefix_rule(
    pattern = ["gh", "api", "graphql"],
    decision = "allow",
    justification = "Reading the Priority field is GitHub-only pickup input. Every other `gh api` verb, and every `git push`, keeps its prompt: a prefix rule cannot bind a write to the claim holder's own target, so none is written for one.",
    match = ["gh api graphql -f query=q"],
    not_match = ["gh api --method DELETE repos/uberblick-ai/uberblick-2/git/refs/heads/x"],
)
