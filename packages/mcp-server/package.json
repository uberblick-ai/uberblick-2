{
  "name": "@uberblick/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP stdio server with a local SQLite mirror (FTS5, tags, backlinks).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./device-login": "./src/device-login.ts",
    "./auth-store": "./src/auth-store.ts",
    "./management-client": "./src/management-client.ts",
    "./init-lock": "./src/init-lock.ts",
    "./safe-write": "./src/safe-write.ts",
    "./remote-url": "./src/remote-url.ts",
    "./storage": "./src/storage.ts",
    "./project-config": "./src/project-config.ts",
    "./project-binding": "./src/project-binding.ts",
    "./workspace-registry": "./src/workspace-registry.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.6.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@uberblick/hub": "workspace:*",
    "@uberblick/schema": "workspace:*",
    "y-protocols": "catalog:",
    "yjs": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
