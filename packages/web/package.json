{
  "name": "@uberblick/web",
  "version": "0.0.0",
  "private": true,
  "description": "Tiptap/ProseMirror web client — viewer/editor for uberblick documents.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@uberblick/schema": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
