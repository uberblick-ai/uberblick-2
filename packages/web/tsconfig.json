{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "dev-config-document.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.menu.config.ts"
  ]
}
