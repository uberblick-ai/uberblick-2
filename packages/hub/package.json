{
  "name": "@uberblick/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Hocuspocus sync hub with SQLite persistence.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./token": "./src/token.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/extension-sqlite": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@uberblick/schema": "workspace:*",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
