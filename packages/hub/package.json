{
  "name": "@uberblick/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Hocuspocus sync hub with SQLite persistence.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./project-config": "./src/project-config.ts",
    "./project-binding": "./src/project-binding.ts",
    "./workspace-registry": "./src/workspace-registry.ts",
    "./protocol": "./src/protocol.ts",
    "./storage": "./src/storage.ts",
    "./token": "./src/token.ts",
    "./auth-store": "./src/auth-store.ts",
    "./safe-write": "./src/safe-write.ts",
    "./init-lock": "./src/init-lock.ts",
    "./remote-url": "./src/remote-url.ts",
    "./device-login": "./src/device-login.ts",
    "./management-client": "./src/management-client.ts",
    "./test-device-sync": "./test/device-sync-hub.ts"
  },
  "scripts": {
    "start": "node --import tsx --import ./src/dev-config.ts src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "4.6.0",
    "@uberblick/schema": "workspace:*",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
