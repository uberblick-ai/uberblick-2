{
  "name": "@uberblick/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Hocuspocus sync hub with SQLite persistence.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./team": "./src/team.ts",
    "./team-config": "./src/team-config.ts",
    "./test-device-sync": "./test/device-sync-hub.ts"
  },
  "scripts": {
    "start": "node --import tsx --import ../mcp-server/src/dev-hub-config.ts src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "4.6.0",
    "@uberblick/schema": "workspace:*",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
