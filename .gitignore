# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
# the `ub` bundle packages/cli's test globalSetup builds once per run, so the
# spawning suites do not transpile three packages in every child
.test-build/

# local data / persistence (hub SQLite, mcp mirror)
data/
packages/*/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
# …except the databases that are test inputs rather than local state: bytes
# written by the better-sqlite3 builds (the MCP mirror, the hub's Hocuspocus
# SQLite extension), which `node:sqlite` has to keep reading.
!packages/*/test/fixtures/*.sqlite

# env / secrets
# NOTE: fnox.toml IS committed — it is age-encrypted.
.env
.env.*

# mise's local config, which `ub init` writes as a file DERIVED from
# $XDG_CONFIG_HOME/uberblick/credentials.json: it carries the generated
# development signing secret so the mise tasks and .mcp.json see the same value.
# Never committed — and the ignore covers the other names mise honours, so a
# contributor's own local config cannot carry a secret into a commit either.
mise.local.toml
.mise.local.toml

# the timestamped copy `ub mcp install --force` leaves beside a config file it
# replaces. It is there so the previous version is recoverable by hand, not so
# it can be committed — and the one config file this repository carries,
# .mcp.json, is exactly where somebody would generate one.
*.bak

# playwright run artifacts (traces, screenshots, HTML report)
test-results/
playwright-report/

# #628's throwaway scenario evidence: one directory per local run, each with a
# video of it. Outside test-results/ on purpose — Playwright empties that at the
# start of every run, so evidence kept there would only ever be the last run's.
# Videos of synthetic data are still nobody's business but the machine that made
# them; nothing here is committed.
packages/web/scenario-evidence/

# editor / OS
.DS_Store
.vite/

# agent-local state; .claude/skills/ is versioned
.claude/worktrees/
.claude/settings.local.json
