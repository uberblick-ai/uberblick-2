# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# local data / persistence (hub SQLite, mcp mirror)
data/
packages/*/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
# …except the one database that is a test input rather than local state: bytes
# written by the better-sqlite3 build, which `node:sqlite` has to keep reading.
!packages/mcp-server/test/fixtures/*.sqlite

# env / secrets
# NOTE: fnox.toml IS committed — it is age-encrypted.
.env
.env.*

# playwright run artifacts (traces, screenshots, HTML report)
test-results/
playwright-report/

# editor / OS
.DS_Store
.vite/

# agent-local state; .claude/skills/ is versioned
.claude/worktrees/
.claude/settings.local.json
