# Cloudflare Pages headers. agents.uberblick.ai and skills.uberblick.ai may load
# the shared stylesheet and the fonts from here, and a browser fetches fonts
# with CORS, so these files allow any origin. They change rarely; the fonts
# never, so they are cached for a year.
/shared.css
  Access-Control-Allow-Origin: *
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
