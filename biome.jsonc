{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",

  // Lint only, by decision (#54): no formatter, no whole-repo reformat diff,
  // no editor config to keep in sync. Same for the assist actions.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },

  // Reuse .gitignore so node_modules/, dist/ and the local SQLite data stay out.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },

  "overrides": [
    {
      // To tighten a limit, lower it, then fix or suppress new failures in a
      // change of its own.
      "includes": ["packages/*/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": { "maxLines": 150, "skipBlankLines": true }
            },
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 40 }
            }
          }
        }
      }
    },
    {
      // Tailwind directives live in this stylesheet. Keep their parser scoped
      // here; UI components use the utilities it generates. Web UI system
      // keeps editor content in plain CSS and migrates other legacy surfaces
      // to utilities when they are next changed.
      "includes": ["packages/web/src/ui/tailwind.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    },
    {
      // The invariant this linter exists to guard: the MCP server writes
      // nothing to stdout except JSON-RPC frames, so a stray console.* there is
      // a protocol bug, not a style question. src/log.ts is the sanctioned path,
      // and its one `console.error` (stderr, never stdout) carries the only
      // suppression.
      "includes": ["packages/mcp-server/src/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    },
    {
      "includes": ["packages/web/src/settings.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{
                  "group": ["yjs", "yjs/**", "y-*", "y-*/**", "@uberblick/*", "@uberblick/**", ":PATH:"],
                  "message": "Local settings must remain independent of collaboration modules."
                }]
              }
            },
            "noCommonJs": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/*/test/**"],
      "linter": {
        "rules": {
          "style": {
            // Tests assert `expect(x).toBeDefined()` and then use `x!`. Biome's
            // fix is `x?.`, which turns a failing test into a passing one.
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            // MCP tool payloads are untyped JSON by contract; `unknown` would
            // mean a cast at every assertion.
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
