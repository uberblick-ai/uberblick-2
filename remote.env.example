# Full MagicDNS name shown by the Tailscale admin console, without https://.
TAILSCALE_HOST=machine-name.tailnet-name.ts.net

# Optional. The hub endpoint Caddy serves at /uberblick-config.json, which is
# what the browser dials. Defaults to wss://$TAILSCALE_HOST/ws. Set it only to
# point this web client at a hub somewhere else; changing it needs a container
# recreate, never a bundle rebuild.
#WEB_HUB_URL=wss://other-host.tailnet-name.ts.net/ws

# The workspaces the web client offers, comma-separated, served in that same
# document. The first entry is what `https://$TAILSCALE_HOST/` opens; with none
# — or with only entries that are not workspace ids, which is what the
# placeholder below is — that address has nothing to open and says so, while
# document links keep working. An id is the uuid `ub status` prints, optionally
# decorated with a display slug (`<slug>-<uuid>`). Changing it needs a container
# recreate, never a bundle rebuild.
WEB_WORKSPACES=replace-with-the-workspace-id-from-ub-status

# This host's Tailscale IPv4 address (`tailscale ip -4`). Publishing only on
# this address keeps Caddy off the host's public and LAN interfaces.
TAILSCALE_IP=100.64.0.1

# Use the same high-entropy signing secret as every MCP client that should sync
# here. Caddy serves it to the web app in /uberblick-config.json — the bundle
# carries none — so anyone who can reach this host has full read-write; keep the
# host on the private tailnet (see REMOTE.md). The secret must use only
# A-Za-z0-9._- characters; the wrapper refuses anything else, because the shell
# and Docker Compose's dotenv parser disagree about other characters (the
# deployed secret could silently diverge) and because it is substituted into
# that document's JSON, where a quote could inject further keys.
HUB_AUTH_TOKEN=replace-with-the-shared-signing-secret

# Optional: the Client ID of your own GitHub App with Device Flow enabled.
# See REMOTE.md. Passed only to the hub; remote init re-runs preserve it.
#HUB_GITHUB_CLIENT_ID=Iv23AbCdEF0123456789
