# Default: this computer only at http://localhost:8080, without Tailscale.
# Docker publishes only 127.0.0.1, and the hub requires each client's stored
# device login even on this route. Optional loopback TCP port:
#LOOPBACK_PORT=8080

# Optional HTTPS for other computers. Use a public DNS name whose records reach
# this host and allow inbound TCP 443; Caddy obtains a publicly trusted cert.
# No scheme, port or slash. The wrapper selects the release's HTTPS files.
#WEB_HOST=hub.example.com
# Optional host IPv4 binding; defaults to 0.0.0.0 for public DNS HTTPS.
#HTTPS_BIND_IP=192.0.2.10

# Recommended optional network layer: Tailscale on Linux, with HTTPS enabled.
# Its certificate comes from the host daemon through the standard socket.
# Use WEB_HOST=machine-name.tailnet-name.ts.net and TAILSCALE_IP from
# `tailscale ip -4`, publishing only on that private address. Existing .env
# files with TAILSCALE_HOST plus TAILSCALE_IP keep working without edits.
#TAILSCALE_HOST=machine-name.tailnet-name.ts.net
#TAILSCALE_IP=100.64.0.1

# Optional browser endpoint override. Defaults to ws://localhost:8080/ws for
# loopback (using LOOPBACK_PORT), or wss://<configured-host>/ws for HTTPS.
# Changing it needs a container recreate, never a bundle rebuild.
#WEB_HUB_URL=wss://other-host.example.com/ws

# Optional comma-separated workspace UUIDs, each optionally prefixed with a
# display slug (<slug>-<uuid>). The first valid entry is offered at the site's
# root. Direct browser sign-in is not yet available; use ub auth login and
# ub open on a computer. Empty means no workspace is offered at the root.
#WEB_WORKSPACES=replace-with-the-workspace-id-from-ub-status

# Remote admission uses each machine's stored device login. No signing secret
# is required or served; a legacy HUB_AUTH_TOKEN line grants no remote access.

# GitHub sign-in uses the public Uberblick Login app by default; no registration
# is needed. Unset or empty selects it. GitHub's approval page names the app,
# not this hub; give first-admin setup codes only to the intended administrator.
# Optional: use your own GitHub App to control its name/settings and avoid the
# shared device-flow budget. Enable Device Flow, keep token expiration, request
# no extra permissions/events, and make it public for users outside its owner.
# See REMOTE.md. Passed only to the hub; release updates keep .env and preserve
# it. Remove the line and recreate the hub to return to the shared default.
#HUB_GITHUB_CLIENT_ID=Iv23AbCdEF0123456789
