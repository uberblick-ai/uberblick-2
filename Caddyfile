{$TAILSCALE_HOST} {
	# The client's runtime configuration: the hub endpoint it dials and the
	# workspaces it offers, and nothing else (#91, #189). Served rather than
	# baked into the bundle, so pointing this deployment at another hub — or
	# giving it its workspaces — is `WEB_HUB_URL=… up --detach caddy`, not a
	# rebuild. `WEB_HUB_URL` and `WEB_WORKSPACES` are the names operators set in
	# `.env`; compose passes them into this container as `HUB_URL` and
	# `WORKSPACES` (see docker-compose.yml, which explains why the names differ).
	#
	# `workspaces` is written as one comma-separated string because that is all
	# an environment substitution can produce; the client reads that spelling and
	# a JSON array as the same list. Unset substitutes to `""`, which the client
	# reads as "no workspaces named" — deep links still open, `/` says there is
	# no workspace.
	#
	# It must be matched before the SPA fallback below. `try_files … /index.html`
	# exists for deep links (#68) and would answer a mis-deployed configuration
	# path with the app's own HTML, which the client can only report as a
	# configuration error. `no-store` is load-bearing for the same reason the
	# document exists: a cached copy keeps a retargeted deployment dialling the
	# old hub.
	handle /uberblick-config.json {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"hubUrl":"{$HUB_URL}","workspaces":"{$WORKSPACES}"}` 200
	}

	handle /ws* {
		reverse_proxy hub:1234
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
