{
	# HTTPS routes expose only port 443. ACME uses TLS-ALPN; never create an
	# HTTP redirect listener on a non-loopback route.
	auto_https disable_redirects
}

{$WEB_SITE} {
	# Public runtime configuration contains only the endpoint and workspace list.
	# Remote browsers have no credential and cannot sign in directly yet; use
	# ub auth login and ub open on a computer. Never serve a signing secret.
	# Entrypoints validate substitutions before Caddy renders these JSON strings.
	# This route precedes the SPA fallback and is uncached so reloads see updates.
	handle /uberblick-config.json {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"hubUrl":"{$HUB_URL}","workspaces":"{$WORKSPACES}"}` 200
	}

	handle /ws* {
		reverse_proxy hub:1234
	}

	handle /auth/* {
		reverse_proxy hub:1234
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
