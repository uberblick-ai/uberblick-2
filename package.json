{
  "name": "uberblick",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, CRDT-backed collaborative document system. MCP-first.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm run test:e2e-runner && pnpm run test:housekeeping && pnpm run test:homebrew-release",
    "test:e2e-runner": "node --test scripts/run-e2e.test.mjs",
    "test:housekeeping": "node --test scripts/housekeeping.test.mjs",
    "test:homebrew-release": "node --test scripts/publish-homebrew-release.test.mjs scripts/homebrew-proof.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@uberblick/cli": "workspace:*",
    "typescript": "^5.9.3"
  }
}
