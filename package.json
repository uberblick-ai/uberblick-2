{
  "name": "uberblick",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, CRDT-backed collaborative document system. MCP-first.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm run test:issue-preparation && pnpm run test:e2e-runner && pnpm run test:agent-roles && pnpm run test:housekeeping",
    "test:e2e-runner": "node --test scripts/run-e2e.test.mjs",
    "test:issue-preparation": "node --test .agents/protocols/issue-preparation.test.mjs",
    "test:agent-roles": "node scripts/check-agent-roles.mjs && node --test scripts/check-agent-roles.test.mjs",
    "test:housekeeping": "node --test scripts/housekeeping.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@uberblick/cli": "workspace:*",
    "typescript": "^5.9.3"
  }
}
