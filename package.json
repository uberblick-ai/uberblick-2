{
  "name": "uberblick",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, CRDT-backed collaborative document system. MCP-first.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome lint --error-on-warnings . && node scripts/lint-e2e-settle.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-unit-tests.mjs all && pnpm run test:scripts",
    "test:scripts": "node --test --test-reporter=dot \"scripts/*.test.mjs\"",
    "test:os": "node scripts/run-unit-tests.mjs os && node --test --test-reporter=dot scripts/check-corpus.test.mjs scripts/cleanup-agent-worktree.test.mjs scripts/housekeeping.test.mjs scripts/run-e2e.test.mjs scripts/run-unit-tests.test.mjs scripts/unit-test-reports.test.mjs",
    "test:e2e-runner": "node --test scripts/run-e2e.test.mjs",
    "test:agent-cleanup": "node --test scripts/cleanup-agent-worktree.test.mjs",
    "test:housekeeping": "node --test scripts/housekeeping.test.mjs",
    "test:hub-release": "node --test scripts/publish-hub-release.test.mjs scripts/publish-hub-release-assets.test.mjs scripts/hub-release-assets.test.mjs scripts/check-hub-image.test.mjs scripts/hub-release-runtime.test.mjs",
    "test:homebrew-release": "node --test scripts/publish-homebrew-release.test.mjs scripts/homebrew-proof.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@uberblick/cli": "workspace:*",
    "typescript": "^5.9.3"
  }
}
