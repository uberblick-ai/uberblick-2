# syntax=docker/dockerfile:1.7

# The review environment, owned by main and never by the commit under review:
# `mise run review` builds an immutable `git archive` context with *this* file,
# and never passes secrets, host mounts, privileged mode, or the Docker socket.
# Changing it is standalone Tier-3 work — it only takes effect once on main.
FROM node:26-bookworm

ENV CI=true
WORKDIR /review

COPY --chown=node:node . .

# package.json is the authority for the exact package-manager version.
RUN npm install --global "$(node -p "require('./package.json').packageManager")" \
    && chown node:node /review

USER node
RUN --mount=type=cache,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile

CMD ["sh", "-lc", "pnpm run lint && pnpm run typecheck && pnpm run test"]
